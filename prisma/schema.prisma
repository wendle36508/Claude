generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Chain/CheckInStatus are plain strings constrained by the TS union
// types in lib/types.ts instead of native enums, so the schema doesn't
// need a migration every time the allowed set changes.

model Location {
  id           String    @id @default(cuid())
  name         String
  chain        String
  address      String
  city         String
  state        String
  lat          Float
  lng          Float
  // Human-readable rotation schedule as reported by the store itself,
  // e.g. "New bins ~10am Mon/Wed/Fri". Used as a fallback signal when
  // there are no recent crowdsourced check-ins yet (cold-start).
  scheduleNote String?
  checkIns     CheckIn[]
  hauls        Haul[]
  createdAt    DateTime  @default(now())
}

model CheckIn {
  id           String        @id @default(cuid())
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId   String
  status       String
  // Haul quality, 1-5 stars. Optional — a status-only report ("just
  // fresh/picked over") is still useful without a rating attached.
  rating       Int?
  note         String?
  // Free-text reporter name, no accounts in the MVP.
  reporterName String?
  createdAt    DateTime      @default(now())

  @@index([locationId, createdAt])
}

// A haul post: what someone found, tagged to the location they got it
// from. Separate from CheckIn (which reports bin freshness) — a haul is
// about the find itself, not the state of the bins. A haul can
// optionally be listed for resale by a Seller — the same find that
// showed up in the location's feed can also show up on someone's
// storefront, without duplicating the post.
model Haul {
  id         String   @id @default(cuid())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String
  // Relative path under /public, or a Vercel Blob URL in production —
  // see app/api/hauls/route.ts.
  imagePath  String
  caption    String?
  posterName String?
  seller     Seller?  @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  sellerId   String?
  forSale    Boolean  @default(false)
  price      Float?
  createdAt  DateTime @default(now())

  @@index([locationId, createdAt])
  @@index([createdAt])
  @@index([sellerId, createdAt])
}

// A reseller's public storefront. No login/password — a handle is
// claimed once (must be unique) and that claim is the only "auth" a
// no-accounts MVP can offer. Good enough while claiming is honor-system
// and nothing valuable (payments, private data) lives behind it; real
// auth becomes necessary before that stops being true.
model Seller {
  id          String   @id @default(cuid())
  handle      String   @unique
  displayName String
  bio         String?
  // Where a buyer actually transacts — Venmo/Poshmark/Instagram/etc.
  // This app displays listings, it doesn't process payments.
  contactLink String?
  hauls       Haul[]
  createdAt   DateTime @default(now())
}
