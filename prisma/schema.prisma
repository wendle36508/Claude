generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// SQLite has no native enum support, so Chain/CheckInStatus are plain
// strings constrained by the TS union types in lib/types.ts instead.

model Location {
  id           String    @id @default(cuid())
  name         String
  chain        String
  address      String
  city         String
  state        String
  lat          Float
  lng          Float
  // Human-readable rotation schedule as reported by the store itself,
  // e.g. "New bins ~10am Mon/Wed/Fri". Used as a fallback signal when
  // there are no recent crowdsourced check-ins yet (cold-start).
  scheduleNote String?
  checkIns     CheckIn[]
  hauls        Haul[]
  createdAt    DateTime  @default(now())
}

model CheckIn {
  id           String        @id @default(cuid())
  location     Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId   String
  status       String
  note         String?
  // Free-text reporter name, no accounts in the MVP.
  reporterName String?
  createdAt    DateTime      @default(now())

  @@index([locationId, createdAt])
}

// A haul post: what someone found, tagged to the location they got it
// from. Separate from CheckIn (which reports bin freshness) — a haul is
// about the find itself, not the state of the bins.
model Haul {
  id         String   @id @default(cuid())
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId String
  // Relative path under /public, e.g. "/uploads/hauls/<id>.jpg".
  imagePath  String
  caption    String?
  posterName String?
  createdAt  DateTime @default(now())

  @@index([locationId, createdAt])
  @@index([createdAt])
}
